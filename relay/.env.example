# Copie para .env (local) ou cadastre no painel/CLI da Vercel. NUNCA commitar valores reais.

# --- Obrigatório: token compartilhado com o relógio (igual ao DEVICE_TOKEN do config.h) ---
# Gere com:  openssl rand -hex 24
DEVICE_TOKEN=

# --- Provedores (deixe vazio para usar o modo mock, sem chave) ---
# Escolha explícita: openai | xai | mock   (vazio = automático pelas chaves presentes)
LLM_PROVIDER=
# openai | mock
STT_PROVIDER=
# openai | elevenlabs | mock
TTS_PROVIDER=

# OpenAI ou qualquer endpoint compatível (Groq, OpenRouter, LM Studio, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
STT_MODEL=gpt-4o-mini-transcribe
LLM_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
# Overrides opcionais por etapa (se STT/TTS estiverem em outro endpoint compatível)
STT_BASE_URL=
STT_API_KEY=
TTS_BASE_URL=
TTS_API_KEY=

# xAI / Grok para o LLM
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning

# ElevenLabs para TTS (usado automaticamente se a chave existir e TTS_PROVIDER estiver vazio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- KV: memória curta por dispositivo + estado das tarefas do Grok Bot ---
# Na Vercel, funções não guardam estado: conecte Upstash Redis (Marketplace). OBRIGATÓRIO para o
# modo Grok Bot na Vercel (sem ele /api/agent responde 503). Aceita KV_REST_API_URL/KV_REST_API_TOKEN ou UPSTASH_REDIS_REST_URL/TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=
MEMORY_TURNS=6
MEMORY_TTL_SECONDS=1800

# --- Modo Grok Bot (botão B do relógio) ---
# URL e chave do webhook da rotina do Grok Bot (https://api2.cursor.sh/automations/webhook/<id>).
# A chave vai nos cabeçalhos Authorization: Bearer e X-Automation-Key. Nunca no código.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
# URL pública usada no callback (opcional; na Vercel usa VERCEL_PROJECT_PRODUCTION_URL automaticamente)
PUBLIC_BASE_URL=
# Tempo máximo de uma tarefa (padrão 900 s = 15 min)
JOB_TIMEOUT_SECONDS=900
# Teste local sem rotina: GROKBOT_WEBHOOK_URL=mock (só no servidor local, não na Vercel)
GROKBOT_MOCK_STEP_MS=1500

# --- Diversos ---
SYSTEM_PROMPT=
# Porta do servidor local
PORT=8787
